---
source: crates/postgres/tests/integration/tags/fetch_by_name_or_alias_like.rs
expression: ctx.queries()
---
queries:
  - sql: |-
      SELECT
        "tags"."id"
      FROM
        "tags"
      INNER JOIN
        "tag_paths" ON "tag_paths"."descendant_id" = "tags"."id"
        AND "tag_paths"."ancestor_id" <> '00000000-0000-0000-0000-000000000000'
      INNER JOIN
        "tags" AS "tag_ancestors" ON "tag_ancestors"."id" = "tag_paths"."ancestor_id"
      LEFT JOIN
        (
          SELECT
            "id",
            COUNT("id") AS "count"
          FROM
            (
              SELECT
                "id",
                unnest("aliases") AS "alias"
              FROM
                "tags"
            ) AS "tags_aliases"
          WHERE
            casefold("alias" COLLATE "tags") LIKE casefold($1 COLLATE "tags")
            AND casefold("alias" COLLATE "tags") LIKE casefold($2 COLLATE "tags")
          GROUP BY
            "id"
        ) AS "tags_aliases" ON "tags_aliases"."id" = "tags"."id"
        AND "tag_paths"."ancestor_id" = "tag_paths"."descendant_id"
      LEFT JOIN
        (
          SELECT
            "id",
            COUNT("id") AS "count"
          FROM
            (
              SELECT
                "id",
                unnest("aliases") AS "alias"
              FROM
                "tags"
            ) AS "tag_ancestors_aliases"
          WHERE
            casefold("alias" COLLATE "tags") LIKE casefold($3 COLLATE "tags")
            AND casefold("alias" COLLATE "tags") LIKE casefold($4 COLLATE "tags")
          GROUP BY
            "id"
        ) AS "tag_ancestors_aliases" ON "tag_ancestors_aliases"."id" = "tags"."id"
        AND "tag_paths"."ancestor_id" <> "tag_paths"."descendant_id"
      GROUP BY
        "tags"."id"
      HAVING
        bool_or(
          casefold("tag_ancestors"."name" COLLATE "tags") LIKE casefold($5 COLLATE "tags")
          OR casefold("tag_ancestors"."kana" COLLATE "tags") LIKE casefold($6 COLLATE "tags")
          OR "tag_ancestors_aliases"."count" > 0
          OR "tags_aliases"."count" > 0
        )
        AND bool_or(
          casefold("tag_ancestors"."name" COLLATE "tags") LIKE casefold($7 COLLATE "tags")
          OR casefold("tag_ancestors"."kana" COLLATE "tags") LIKE casefold($8 COLLATE "tags")
          OR "tag_ancestors_aliases"."count" > 0
          OR "tags_aliases"."count" > 0
        )
      ORDER BY
        casefold("tags"."name" COLLATE "tags") = casefold($9 COLLATE "tags")
        OR casefold("tags"."name" COLLATE "tags") = casefold($10 COLLATE "tags") DESC,
        casefold("tags"."kana" COLLATE "tags") = casefold($11 COLLATE "tags")
        OR casefold("tags"."kana" COLLATE "tags") = casefold($12 COLLATE "tags") DESC,
        strpos(
          casefold("tags"."name" COLLATE "tags"),
          casefold($13 COLLATE "tags")
        ) = 1
        OR strpos(
          casefold("tags"."name" COLLATE "tags"),
          casefold($14 COLLATE "tags")
        ) = 1 DESC,
        strpos(
          casefold("tags"."kana" COLLATE "tags"),
          casefold($15 COLLATE "tags")
        ) = 1
        OR strpos(
          casefold("tags"."kana" COLLATE "tags"),
          casefold($16 COLLATE "tags")
        ) = 1 DESC,
        (
          array_length(
            string_to_array(
              casefold("tags"."name" COLLATE "tags"),
              casefold($17 COLLATE "tags")
            ),
            1
          ) - 1
        ) + (
          array_length(
            string_to_array(
              casefold("tags"."name" COLLATE "tags"),
              casefold($18 COLLATE "tags")
            ),
            1
          ) - 1
        ) DESC,
        (
          NULLIF(
            strpos(
              casefold("tags"."name" COLLATE "tags"),
              casefold($19 COLLATE "tags")
            ),
            0
          ),
          NULLIF(
            strpos(
              casefold("tags"."name" COLLATE "tags"),
              casefold($20 COLLATE "tags")
            ),
            0
          )
        ) ASC,
        (
          NULLIF(
            strpos(
              casefold("tags"."kana" COLLATE "tags"),
              casefold($21 COLLATE "tags")
            ),
            0
          ),
          NULLIF(
            strpos(
              casefold("tags"."kana" COLLATE "tags"),
              casefold($22 COLLATE "tags")
            ),
            0
          )
        ) ASC,
        SUM(COALESCE("tags_aliases"."count", 0)) DESC,
        bool_or(
          casefold("tag_ancestors"."name" COLLATE "tags") = casefold($23 COLLATE "tags")
          OR casefold("tag_ancestors"."name" COLLATE "tags") = casefold($24 COLLATE "tags")
        ) DESC,
        bool_or(
          casefold("tag_ancestors"."kana" COLLATE "tags") = casefold($25 COLLATE "tags")
          OR casefold("tag_ancestors"."kana" COLLATE "tags") = casefold($26 COLLATE "tags")
        ) DESC,
        bool_or(
          strpos(
            casefold("tag_ancestors"."name" COLLATE "tags"),
            casefold($27 COLLATE "tags")
          ) = 1
          OR strpos(
            casefold("tag_ancestors"."name" COLLATE "tags"),
            casefold($28 COLLATE "tags")
          ) = 1
        ) DESC,
        bool_or(
          strpos(
            casefold("tag_ancestors"."kana" COLLATE "tags"),
            casefold($29 COLLATE "tags")
          ) = 1
          OR strpos(
            casefold("tag_ancestors"."kana" COLLATE "tags"),
            casefold($30 COLLATE "tags")
          ) = 1
        ) DESC,
        MAX(
          (
            array_length(
              string_to_array(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($31 COLLATE "tags")
              ),
              1
            ) - 1
          ) + (
            array_length(
              string_to_array(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($32 COLLATE "tags")
              ),
              1
            ) - 1
          )
        ) DESC,
        SUM(
          (
            array_length(
              string_to_array(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($33 COLLATE "tags")
              ),
              1
            ) - 1
          ) + (
            array_length(
              string_to_array(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($34 COLLATE "tags")
              ),
              1
            ) - 1
          )
        ) DESC,
        (
          MIN(
            NULLIF(
              strpos(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($35 COLLATE "tags")
              ),
              0
            )
          ),
          MIN(
            NULLIF(
              strpos(
                casefold("tag_ancestors"."name" COLLATE "tags"),
                casefold($36 COLLATE "tags")
              ),
              0
            )
          )
        ) ASC,
        (
          MIN(
            NULLIF(
              strpos(
                casefold("tag_ancestors"."kana" COLLATE "tags"),
                casefold($37 COLLATE "tags")
              ),
              0
            )
          ),
          MIN(
            NULLIF(
              strpos(
                casefold("tag_ancestors"."kana" COLLATE "tags"),
                casefold($38 COLLATE "tags")
              ),
              0
            )
          )
        ) ASC,
        SUM(COALESCE("tag_ancestors_aliases"."count", 0)) DESC,
        casefold("tags"."kana" COLLATE "tags") ASC

    rows_affected: 1
    rows_returned: 1
  - sql: |-
      SELECT
        "tag_orders"."order",
        "distance",
        "tag_ancestors"."id" AS "ancestor_id",
        "tag_ancestors"."name" AS "ancestor_name",
        "tag_ancestors"."kana" AS "ancestor_kana",
        "tag_ancestors"."aliases" AS "ancestor_aliases",
        "tag_ancestors"."created_at" AS "ancestor_created_at",
        "tag_ancestors"."updated_at" AS "ancestor_updated_at",
        "tag_descendants"."id" AS "descendant_id",
        "tag_descendants"."name" AS "descendant_name",
        "tag_descendants"."kana" AS "descendant_kana",
        "tag_descendants"."aliases" AS "descendant_aliases",
        "tag_descendants"."created_at" AS "descendant_created_at",
        "tag_descendants"."updated_at" AS "descendant_updated_at"
      FROM
        "tag_paths"
      LEFT JOIN
        (
          SELECT
            "column1" AS "order",
            "column2" AS "id"
          FROM
            (
              VALUES
                ($1, $2), ($3, $4)) AS "tag_orders"
        ) AS "tag_orders" ON "tag_orders"."id" = "descendant_id"
        AND "ancestor_id" IN (
          "descendant_id",
          '00000000-0000-0000-0000-000000000000'
        )
      INNER JOIN
        "tags" AS "tag_ancestors" ON "tag_ancestors"."id" = "tag_paths"."ancestor_id"
      INNER JOIN
        "tags" AS "tag_descendants" ON "tag_descendants"."id" = "tag_paths"."descendant_id"
      WHERE
        (
          "distance" = 0
          AND "ancestor_id" IN ($5)
        )
        OR (
          "distance" <= 1
          AND "descendant_id" IN (
            SELECT
              "ancestor_id"
            FROM
              "tag_paths"
            WHERE
              "distance" <= $6
              AND "descendant_id" IN ($7)
          )
        )
        OR (
          "distance" <= 1
          AND "ancestor_id" IN (
            SELECT
              "descendant_id"
            FROM
              "tag_paths"
            WHERE
              "distance" <= $8
              AND "ancestor_id" IN ($9)
          )
        )
      ORDER BY
        "distance" ASC,
        "tag_orders"."order" ASC,
        "tag_ancestors"."kana" ASC,
        "tag_descendants"."kana" ASC

    rows_affected: 6
    rows_returned: 6
